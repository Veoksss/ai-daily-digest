# .env.example — 复制为 .env 并填写实际值
# 本地开发时使用，GitHub Actions 中通过 Secrets 配置

# DeepSeek API Key（必填）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# SMTP 邮件配置（可选，不填则跳过邮件发送）
# QQ 邮箱：smtp.qq.com:587，密码填"授权码"（非QQ密码）
# Gmail：smtp.gmail.com:587，密码填"应用专用密码"
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASS=your-auth-code
SMTP_TO=receiver@qq.com
SMTP_FROM_NAME=AI Daily Digest
