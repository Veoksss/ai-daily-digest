<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Daily Digest — {{ date }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans SC", sans-serif;
            background: #f5f5f5;
            color: #333;
            line-height: 1.6;
        }
        .container { max-width: 900px; margin: 0 auto; padding: 20px; }
        header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
            border-radius: 0 0 20px 20px;
            margin-bottom: 30px;
        }
        header h1 { font-size: 28px; margin-bottom: 8px; }
        header p { opacity: 0.85; font-size: 14px; }
        .stats {
            display: flex; justify-content: center; gap: 30px;
            margin: 20px 0; flex-wrap: wrap;
        }
        .stat {
            background: rgba(255,255,255,0.15);
            padding: 12px 24px; border-radius: 12px;
            text-align: center;
        }
        .stat .num { font-size: 24px; font-weight: 700; }
        .stat .label { font-size: 12px; opacity: 0.8; }
        .filters {
            display: flex; gap: 8px; flex-wrap: wrap;
            margin-bottom: 20px; justify-content: center;
        }
        .filter-btn {
            padding: 6px 16px; border: 1.5px solid #ddd;
            background: white; border-radius: 20px;
            cursor: pointer; font-size: 13px;
            transition: all 0.2s;
        }
        .filter-btn:hover, .filter-btn.active {
            background: #667eea; color: white; border-color: #667eea;
        }
        .article {
            background: white;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 16px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            transition: box-shadow 0.2s;
        }
        .article:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
        .article h2 {
            font-size: 17px; margin-bottom: 6px; line-height: 1.4;
        }
        .article h2 a {
            color: #1a0dab; text-decoration: none;
        }
        .article h2 a:hover { text-decoration: underline; }
        .meta {
            font-size: 12px; color: #888;
            margin-bottom: 10px; display: flex; gap: 12px;
            align-items: center; flex-wrap: wrap;
        }
        .source-badge {
            padding: 2px 10px; border-radius: 10px;
            font-size: 11px; font-weight: 600; color: white;
        }
        .source-arxiv { background: #b31b1b; }
        .source-paperswithcode { background: #21ba45; }
        .source-theverge { background: #fa4b2a; }
        .source-techcrunch { background: #0d9e00; }
        .tag {
            display: inline-block; padding: 2px 10px;
            border-radius: 10px; font-size: 11px;
            background: #e8eaf6; color: #3949ab;
            margin-right: 4px;
        }
        .score {
            font-size: 11px; color: #f59e0b;
        }
        .cn-summary {
            font-size: 14px; color: #555;
            margin-top: 8px; padding-top: 8px;
            border-top: 1px solid #f0f0f0;
        }
        footer {
            text-align: center; padding: 30px;
            color: #aaa; font-size: 12px;
        }
        .no-articles {
            text-align: center; padding: 60px; color: #999;
        }
    </style>
</head>
<body>
    <header>
        <h1>🤖 AI Daily Digest</h1>
        <p>{{ date }}</p>
        <div class="stats">
            <div class="stat">
                <div class="num">{{ total }}</div>
                <div class="label">📄 文章总数</div>
            </div>
            <div class="stat">
                <div class="num">{{ sources|length }}</div>
                <div class="label">📡 数据源</div>
            </div>
            <div class="stat">
                <div class="num">{{ "%.1f"|format(avg_score) }}</div>
                <div class="label">⭐ 平均得分</div>
            </div>
        </div>
    </header>

    <div class="container">
        {% if articles %}
        <div class="filters">
            <button class="filter-btn active" onclick="filterAll()">全部</button>
            {% for tag in all_tags %}
            <button class="filter-btn" onclick="filterByTag('{{ tag }}')">{{ tag }}</button>
            {% endfor %}
        </div>

        {% for article in articles %}
        <div class="article" data-tags="{{ article.tags|join(',') }}">
            <h2><a href="{{ article.url }}" target="_blank" rel="noopener">{{ article.title }}</a></h2>
            <div class="meta">
                <span class="source-badge source-{{ article.source }}">{{ article.source_label }}</span>
                <span>{{ article.published_at[:19] }}</span>
                <span class="score">{{ '★' * article.score }}{{ '☆' * (5 - article.score) }}</span>
                {% for tag in article.tags %}
                <span class="tag">{{ tag }}</span>
                {% endfor %}
            </div>
            <div class="cn-summary">{{ article.cn_summary }}</div>
        </div>
        {% endfor %}
        {% else %}
        <div class="no-articles">
            <p>😴 今天没有新的 AI 文章</p>
            <p style="font-size:13px;margin-top:8px;">可能是 API 限流或网络波动，请稍后再看</p>
        </div>
        {% endif %}
    </div>

    <footer>
        <p>Generated by AI Daily Digest · {{ generated_at }}</p>
        <p><a href="https://github.com" style="color:#aaa;">View on GitHub</a></p>
    </footer>

    <script>
        function filterAll() {
            document.querySelectorAll('.article').forEach(el => el.style.display = '');
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            document.querySelector('.filter-btn').classList.add('active');
        }
        function filterByTag(tag) {
            document.querySelectorAll('.article').forEach(el => {
                const tags = el.dataset.tags || '';
                el.style.display = tags.includes(tag) ? '' : 'none';
            });
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.remove('active');
                if (b.textContent.trim() === tag) b.classList.add('active');
            });
        }
    </script>
</body>
</html>
